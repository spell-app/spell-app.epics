+
+  /* ## Columns mode:  a column per level, side by side, each scrolling its own rows */
+  .columns {
+    position: relative;
+    display: flex;
+    height: var(--_ui-tree-columns-height);
+    overflow-x: auto;
+    overflow-y: hidden;
+    overscroll-behavior-x: contain;
+    border: 1px solid var(--ui-border-color, color-mix(in oklab, var(--ui-text-color) 15%, transparent));
+    border-radius: var(--ui-border-radius, 4px);
+  }
+  .column {
+    position: relative;
+    flex: 0 0 var(--_ui-tree-column-width);
+    margin: 0;
+    padding: 2px 0;
+    list-style: none;
+    overflow-y: auto;
+    overscroll-behavior-y: contain;
+    border-inline-end: 1px solid var(--ui-border-color, color-mix(in oklab, var(--ui-text-color) 15%, transparent));
+  }
+  .column-row {
+    display: flex;
+    align-items: center;
+    gap: var(--_ui-tree-gap);
+    box-sizing: border-box;
+    min-height: var(--_ui-tree-row-height);
+    padding-inline: 8px 6px;
+    white-space: nowrap;
+    outline: none;
+  }
+  .column-row:hover {
+    background: var(--_ui-tree-hover-background);
+  }
+  .column-row.on-path {
+    background: var(--_ui-tree-path-background);
+  }
+  .column-row.selected:not(.on-path) {
+    background: var(--_ui-tree-selected-background);
+    color: var(--_ui-tree-selected-color);
+  }
+  /* the column the keys are in shows its selection fully, as a file browser's does */
+  .column:focus-within .column-row.selected {
+    background: var(--_ui-tree-selected-background);
+    color: var(--_ui-tree-selected-color);
+  }
+  .column-row:focus-visible {
+    outline: var(--ui-focus-width) solid var(--ui-focus-color);
+    outline-offset: calc(var(--ui-focus-width) * -1);
+  }
+  .column-row > .label {
+    flex: 1 1 auto;
+  }
+  .count {
+    flex: none;
+    font-size: 0.85em;
+    font-variant-numeric: tabular-nums;
+    color: var(--_ui-tree-muted-color);
+  }
+  .chevron {
+    flex: 0 0 0.62em;
+    height: 0.62em;
+    background: var(--_ui-tree-muted-color);
+    clip-path: polygon(20% 5%, 90% 50%, 20% 95%);
+  }
+  .column-row.selected > .chevron {
+    background: currentColor;
+  }
+  .column > .empty {
+    list-style: none;
+  }
 }
