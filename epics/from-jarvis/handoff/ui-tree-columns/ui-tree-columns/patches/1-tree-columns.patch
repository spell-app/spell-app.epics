+  }
+
+  /** Scroll each column to its selected row, and the box of columns to the last. */
+  private revealPath() {
+    E.afterSolidUpdate(() => {
+      const root = this.domElement.renderRoot
+      const box = root.querySelector(".columns") as HTMLElement | null
+      if (!box) return
+      for (const column of box.querySelectorAll<HTMLElement>("ul.column")) {
+        const selected = column.querySelector<HTMLElement>("li.selected")
+        if (selected) revealIn(column, selected, "vertical")
+      }
+      const last = box.lastElementChild as HTMLElement | null
+      if (last) revealIn(box, last, "horizontal")
+    })
+  }
