+/**
+ * The data a `<ui-tree>` takes as its `items` property (`mode="columns"`).
+ */
+
+/****************
+ * ### `TreeItemData`
+ * One item of a tree given as data:  a row of a column, and, with `children`, the column it opens.
+ * - `children`:  a list, or a function that makes it.
+ *   - The function runs once, the first time the item opens, and its list is kept:  for big trees, made as they're browsed.
+ *   - A function always counts as children, so its row shows a chevron before it's run.
+ ****************/
+export interface TreeItemData {
+  /** Which item it is among its siblings:  what `path` holds. */
+  id: string
+  /** What the row says. */
+  label: string
+  /** The icon before the label. */
+  icon?: string
+  /** Which one it is, quieter, after its label. */
+  which?: string
+  /** The count its row shows with `counts`.  None:  its `children`' length, when they're a list. */
+  count?: number
+  /** The items inside it. */
+  children?: readonly TreeItemData[] | (() => readonly TreeItemData[])
+  /** The page's own, handed back in the events. */
+  data?: unknown
+}
