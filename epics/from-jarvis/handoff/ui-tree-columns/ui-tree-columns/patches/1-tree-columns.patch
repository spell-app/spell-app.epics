+
+  ////////////////
+  // ## Columns
+  //
+  // `mode="columns"`:  a column per level of the open path, drawn in the shadow root from `TreeItemData`:
+  // `items`, or items made from the `<ui-tree-item>`s (their id:  `value`, else `label`).
+  // - `openPath` (the `path` property) is the one fact:  each column shows its id selected,
+  //   and the last one's children are the next column.
+  // - Only those columns are drawn;  a `children` function runs once, and its list is kept.
+  // - The keys select as they move, as a file browser's do:  up and down in a column, right into the next,
+  //   left back out.  One tab stop:  the selected row of the column the keys are in.
+  // - `filter`:  one column, the last on screen as it starts, until it's cleared;  so moving about doesn't move it.
+  ////////////////
+
+  /** In columns mode. */
+  @E.cssState("columns")
+  get isColumns(): boolean {
+    return this.mode === COLUMNS
+  }
+
+  /** The ids from the top down to the selected item:  the `path` property. */
+  @E.controlled("path") accessor openPath: readonly string[] = []
+
+  /** Which column the keys are in. */
+  @E.state accessor keyDepth = 0
+
+  /** The column `filter` filters, set as it starts. */
+  @E.state accessor filterDepth = 0
+
+  /** Counts changes to the `<ui-tree-item>`s, so the items made from them are made again. */
+  @E.state accessor rowsGeneration = 0
+
+  /** Each item's children, once made. */
+  private readonly childrenOfItem = new WeakMap<TreeItemData, readonly TreeItemData[]>()
+
+  /** The items made from each element's `<ui-tree-item>`s:  forgotten when they change. */
+  private itemsOfRows = new WeakMap<Element, readonly TreeItemData[]>()
+
+  /** The top items:  `items`, else made from the rows. */
+  private get topItems(): readonly TreeItemData[] {
+    const items = this.items as unknown
+    if (Array.isArray(items)) return items as TreeItemData[]
+    void this.rowsGeneration
+    return this.itemsIn(this.domElement)
+  }
+
+  /** The items made from the rows directly under `parent`, the same list each time until they change. */
+  private itemsIn(parent: Element): readonly TreeItemData[] {
+    const known = this.itemsOfRows.get(parent)
+    if (known) return known
+    const rows = this.rowsIn(parent)
+    if (this.hasRowsToCome(parent)) return []
+    const items = rows.map((row) => {
+      const hasRows = row.hasRows
+      return {
+        id: row.valueOrLabel,
+        label: row.label ?? "",
+        icon: row.icon,
+        which: row.which,
+        children: hasRows ? () => this.itemsIn(row.domElement) : undefined,
+        count: hasRows ? this.rowsIn(row.domElement).length : undefined,
+        data: row.domElement
+      } satisfies TreeItemData
+    })
+    this.itemsOfRows.set(parent, items)
+    return items
+  }
+
+  /**
+   * Are some of `parent`'s rows not made yet (connected before their tag was defined)?
+   * Then the items are made again after this update:  a few times at most, in case one never is.
+   */
+  private hasRowsToCome(parent: Element): boolean {
+    const isRowToCome = (child: Element) =>
+      child.localName.includes("-") && !child.slot && !(child as E.DOMElement).component
+    if (![...parent.children].some(isRowToCome) || this.rowsRetries >= ROWS_RETRIES) return false
+    if (!this.isRowsRetryQueued) {
+      this.isRowsRetryQueued = true
+      this.rowsRetries++
+      E.afterSolidUpdate(() => {
+        this.isRowsRetryQueued = false
+        this.itemsOfRows = new WeakMap()
+        this.rowsGeneration++
+      })
+    }
+    return true
+  }
+
+  /** A remake of the items is queued, for rows not made yet. */
+  private isRowsRetryQueued = false
+
+  /** How many times the items were made again, for rows not made yet. */
+  private rowsRetries = 0
+
+  /** `item`'s children, made once. */
+  private childrenOf(item: TreeItemData): readonly TreeItemData[] {
+    const known = this.childrenOfItem.get(item)
+    if (known) return known
+    const { children } = item
+    const made = typeof children === "function" ? children() : (children ?? [])
+    this.childrenOfItem.set(item, made)
+    return made
+  }
+
+  /** Does `item` open a column?  A function counts before it's run. */
