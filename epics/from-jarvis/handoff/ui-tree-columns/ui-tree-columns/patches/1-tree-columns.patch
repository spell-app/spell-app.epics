+      },
+      ArrowLeft: () => {
+        if (depth === 0) return
+        const parentId = this.shownPath[depth - 1]
+        go(
+          this.shownIn(this.columnLists[depth - 1] ?? [], depth - 1).find((each) => each.id === parentId),
+          depth - 1
+        )
+      },
+      Enter: () => go(item),
+      " ": () => go(item)
