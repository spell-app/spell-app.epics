 /** `choose` of a tree whose rows are selected many at a time. */
 const MANY = "many"
+
+/** How many times the columns wait for rows not made yet. */
+const ROWS_RETRIES = 5
+
+/** `mode` of a tree drawn as columns. */
+const COLUMNS = "columns"
+
+/**
+ * Scroll `box` the least that shows `element`, one way only, so the page itself never moves.
+ * - `box` is `element`'s offset parent (the sheet makes columns and their box `position: relative`).
+ */
+function revealIn(box: HTMLElement, element: HTMLElement, way: "vertical" | "horizontal") {
+  const isVertical = way === "vertical"
+  const from = isVertical ? element.offsetTop : element.offsetLeft
+  const size = isVertical ? element.offsetHeight : element.offsetWidth
+  const view = isVertical ? box.clientHeight : box.clientWidth
+  const scroll = isVertical ? box.scrollTop : box.scrollLeft
+  const next = from < scroll ? from : from + size > scroll + view ? from + size - view : scroll
+  if (next === scroll) return
+  if (isVertical) box.scrollTop = next
+  else box.scrollLeft = next
+}
