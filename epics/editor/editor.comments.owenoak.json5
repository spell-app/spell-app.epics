    "c4": {
      "anchor": "j191",
      "kind": "item",
      "label": "I225: a computed value longer than 12 letters (a long name, 'king of diamonds') takes a whole row; a yes or no, a number or up to 12 letters takes half, two to a row.",
      "excerpt": "I225: a computed value longer than 12 letters (a long name, 'king of diamonds') takes a whole row; a yes or no, a number or up to 12 letters takes half, two to a row.",
      "text": "20 letters",
