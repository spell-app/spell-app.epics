  {
    "id": "j52",
    "action": "approve",
    "did": "approved:  closed (accepted)",
    "at": "2026-11-16T23:17:09.322Z",
    "before": {
      "attributes": {
        "id": "j52",
        "title": "T16:  `|>` becomes `/>` only between a tag's attributes (or right after its name);  in an unquoted HTML value (`a=b|>`) the bar is the value's, so it's left alone.  `|` is no part of a tag anywhere in Spell's markup.  It writes exactly `/` over the `|`:  `<divider|>` gives `<divider/>` with no space added, so type the space as the house style asks.",
        "status": "open",
        "state": "open",
        "changed": "2026-11-16T11:02:42-05:00",
        "calm": ""
      },
      "label": null
    },
    "after": {
      "attributes": {
        "id": "j52",
        "status": "done",
        "state": "open",
        "changed": "2026-11-16T18:17:09-05:00",
        "reviewed": "2026-11-16",
        "review-as": "approve",
        "calm": ""
      },
      "label": null
    },
    "undoable": true
  },
