{
  "fileColumn": false,
  "sections": [
    {
      "id": "sagas",
      "title": "The sagas, in order",
      "icon": "bullseye",
      "reorder": true,
      "description": "Most exciting first.  Each box is `Title · saga-id`:  type over it to rename;  give two rows the same box to merge them;  clear a box to drop that saga;  move rows with the arrows.  A saga id is one or two words, hyphenated"
    },
    {
      "id": "epics",
      "title": "Each epic's saga",
      "icon": "map",
      "description": "Every epic in exactly one saga.  Each box holds the saga id Claude proposes:  type another saga's id to move the epic there"
    },
    {
      "id": "guides",
      "title": "Each guide's saga",
      "icon": "book open",
      "description": "For the Guides page, which gets a section per saga in your order, then `misc` last.  Type another saga's id, or `misc` for a guide that serves no one saga"
    }
  ],
