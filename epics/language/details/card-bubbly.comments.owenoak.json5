        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-11T02:26:58.648Z",
          "html": "<p>Done: the whole drawing starts 4px further in from the box's left edge, so <code>a \"card\" ...</code>'s band is 4px clear of it.</p>\n<epic-net-effect><ul><li>Every drawing on both pages (the box's left padding).</li></ul></epic-net-effect>"
        }
      ],
      "claim": {
        "by": "owenoak",
