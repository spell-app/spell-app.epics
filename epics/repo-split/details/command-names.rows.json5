    {
      "id": "lang-spell-spell-check-projects",
      "section": "lang-spell",
      "file": "spell-app/cli/src/main.ts",
      "line": 56,
      "purpose": "Lists every error in your spell projects, one per line as file:line:column, and fails if there are any. Use it before committing, or in CI.",
      "current": "spell check [projects...]",
      "recommended": "",
      "note": "mixed: checking a project's editor pages (*.editor.html, its custom property editors) against its types, and --fix for them, is spell-app's"
    },
    {
      "id": "lang-spell-spell-compile-projects",
      "section": "lang-spell",
      "file": "spell-app/cli/src/main.ts",
      "line": 44,
      "purpose": "Turns spell projects into JavaScript (<Project>.spell.js), or prints one file's compiled output with --stdout. Use it to build a project, or to see what a line of spell becomes.",
      "current": "spell compile [projects...]",
      "recommended": "",
      "note": "mixed: compiling each *.editor.html into its <type-editor> module, and the build folder it writes into (spaces), are spell-app's"
    },
    {
      "id": "lang-spell-spell-describe-project-name-member",
      "section": "lang-spell",
      "file": "spell-app/cli/src/main.ts",
      "line": 67,
      "purpose": "Prints what a file or project declares -- its types, properties and methods -- the way the editor's Type Explorer shows them, or everything about one of them. Use it to look up a type without opening the editor.",
      "current": "spell describe [project] [name] [member]",
      "recommended": ""
    },
    {
