  "rows": [
    {
      "id": "kit-spell-spell-epic-verb-args",
      "section": "kit-spell",
      "file": "spell-app/cli/src/devProgram.ts",
      "line": 52,
      "purpose": "The old way to type the `epic` command, which runs the planning tools for epics (multi-phase pieces of work). It hands everything after `epic` on to `epic` unchanged.",
      "current": "spell epic <verb> [args...]",
      "recommended": "",
      "note": "old spelling, still listed in spell --help; declared in devProgram.ts and started by the lean entry (devMain.ts); runs spell-epic's `epic`"
    },
    {
      "id": "kit-spell-spell-help-command",
      "section": "kit-spell",
      "file": "spell-app/cli/src/main.ts",
      "line": 228,
      "purpose": "Shows the help for spell, or for one command (spell help compile).",
      "current": "spell help [command]",
      "recommended": "",
      "note": "our own help command: commander's built-in one is turned off, so an unknown command is an error"
    },
    {
      "id": "kit-spell-spell-pony-words",
      "section": "kit-spell",
      "file": "spell-app/cli/src/main.ts",
      "line": 219,
      "purpose": "Prints a pony in Spell's wizard hat saying something -- your words, or one of its own. A bit of fun; --gallop animates it.",
      "current": "spell pony [words...]",
      "recommended": ""
    },
    {
      "id": "kit-spell-spell-dev-bundles-build-names",
      "section": "kit-spell",
      "file": "spell-app/cli/src/commands/bundlesCommand.ts",
      "line": 22,
      "purpose": "Builds the bundles the page server serves -- Spell UI's docs site, the brand pages -- which are built on demand, never committed; --stale rebuilds only what changed.",
      "current": "spell dev bundles build [names...]",
      "recommended": "",
      "note": "the bundle list is in package.json (pageServer.bundles); the logic is spell-kit's assembler"
    },
    {
      "id": "kit-spell-spell-dev-bundles-check-names",
      "section": "kit-spell",
      "file": "spell-app/cli/src/commands/bundlesCommand.ts",
      "line": 50,
      "purpose": "Says which of those bundles are out of date, and why; fails if any are.",
      "current": "spell dev bundles check [names...]",
      "recommended": ""
    },
    {
      "id": "kit-spell-spell-dev-commands-list",
      "section": "kit-spell",
      "file": "spell-app/cli/src/devProgram.ts",
      "line": 180,
      "purpose": "Lists every command the repos have -- yarn scripts, spell commands, Claude skills -- each marked by whether the commands docs page covers it.",
      "current": "spell dev commands [list]",
      "recommended": "",
      "note": "list is the default verb"
    },
    {
      "id": "kit-spell-spell-dev-commands-check",
      "section": "kit-spell",
      "file": "spell-app/cli/src/commands/commandsCommand.ts",
      "line": 33,
      "purpose": "Only the gaps between the commands and the commands docs page; fails if there are any. Run it after adding, renaming or removing a command.",
      "current": "spell dev commands check",
      "recommended": "",
      "note": "root yarn commands:check"
    },
    {
