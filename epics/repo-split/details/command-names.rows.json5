      "id": "kit-spell-spell-dev-wwod-check-files",
      "section": "kit-spell",
      "file": "spell-app/cli/src/devProgram.ts",
      "line": 189,
      "purpose": "Checks the coding-agent rulebook (WWOD, \"What Would Owen Do?\") and the AGENTS.md / CLAUDE.md / skill files: every rule citation and repo path must point at something real.",
