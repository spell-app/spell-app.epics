      "recommended": "",
      "note": "check is the only verb, and the default"
    },
    {
      "id": "kit-yarn-yarn-kit-ts",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 207,
      "purpose": "Type-checks the kit's own folders (util, toolchain, server, assembler, element) one by one, building the type declarations the repos above read. Run it after changing kit code; `yarn ts` runs it first.",
      "current": "yarn kit:ts",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-test",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 208,
      "purpose": "Runs the tests of each of the kit's own folders in turn (Vitest). Run it after changing kit code; `yarn test` runs it first.",
      "current": "yarn kit:test",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-lint",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 209,
      "purpose": "Lints the kit's own folders and their tests with oxlint, failing on any warning. `yarn lint` runs it first.",
      "current": "yarn kit:lint",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-lint-fix",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 210,
      "purpose": "Lints the kit's own folders and fixes what oxlint can fix by itself.",
      "current": "yarn kit:lint:fix",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-format",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 211,
      "purpose": "Formats the kit's own folders and their tests with oxfmt, the house formatter.",
      "current": "yarn kit:format",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-format-check",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 212,
      "purpose": "Checks that the kit's own folders are formatted, changing nothing; fails if any file would change.",
      "current": "yarn kit:format:check",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-kit-review",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 213,
      "purpose": "The finishing pass for kit changes: type check, lint with fixes, format, then tests, stopping at the first that fails.",
      "current": "yarn kit:review",
      "recommended": ""
    },
    {
      "id": "kit-yarn-yarn-server-serve-start-stop-status-url-file-prune",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 214,
      "purpose": "Runs the page server, the local web server that serves the docs, epic pages and the editor's API for a checkout: start it in the background, stop it, check it, or get the URL of a file.",
      "current": "yarn server <serve | start | stop | status | url <file> | prune>",
      "recommended": "",
      "note": "spell-app's `yarn server` reaches the same tool through `spell dev server`"
    },
    {
      "id": "kit-yarn-yarn-favicon-hat-0-74",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 215,
      "purpose": "Regenerates Spell's favicon (the white hat on an aubergine square) as SVG and PNGs, using a headless browser for the PNGs. Run it only after the hat logo changes.",
      "current": "yarn favicon [--hat 0.74]",
      "recommended": "",
      "note": "its header still says `packages/server`, and it writes the app's copies to `app/static/favicon/` beside the kit's `server/`, a pre-split path"
    },
    {
      "id": "kit-yarn-yarn-postinstall",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 216,
      "purpose": "Makes the links every repo needs after an install: `node_modules/spell-kit` pointing at the kit, and each child repo's `agents` link to the shared house-style folder.",
      "current": "yarn postinstall",
      "recommended": "",
      "note": "runs on every yarn install"
    },
    {
      "id": "kit-yarn-yarn-clone-repo-branch-name-https-shallow-no-install",
      "section": "kit-yarn",
      "file": "package.json",
      "line": 218,
      "purpose": "Clones the child repos that are missing (the ones named and everything they need, or all of them), then runs one `yarn install` over everything. The first thing to run in a fresh kit checkout.",
      "current": "yarn clone [repo ...] [--branch <name>] [--https] [--shallow] [--no-install]",
      "recommended": ""
    },
