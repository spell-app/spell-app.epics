  "comments": {
    "c1": {
      "anchor": "i254",
      "kind": "item",
      "label": "A half-typed note goes out as a comment",
      "excerpt": "A half-typed note goes out as a comment",
      "text": "You seem to be reloading the epic pages frequently, often when I am typing in a field like this one -- that seems to submit the comment.  \n\nBefore reloading, you shoulld note if i'm typing in a field or a bullhorn and the reload should focus in the field and scroll so it is visible.",
      "by": "owenoak",
      "at": "2026-11-15T19:30:44.042Z",
      "status": "answered",
      "replies": [
        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-15T19:51:50.818Z",
          "html": "<p>You were right:  a reload could land while you were in a comment, and the comment then looked sent.</p>\n<p>What went wrong:  a reload waits while you type, but not when you'd only clicked back into the box, nor while the page was out of sight.\nThe bullhorn's box went away, and the comment it had already saved showed as a thread, for Auto Send to send.</p>\n<p>What changed (I291, on main):  the page notes the box you're in as it reloads, and brings it back after:\nthe bullhorn's box for the same comment, a thread's reply box, or an item's note box, with your text, the cursor where it was and the focus, scrolled into sight.\nAuto Send waits until it's back.</p>",
          "commit": "251170773"
        }
      ],
      "claim": {
        "by": "owenoak",
        "agent": "claude",
        "at": "2026-11-15T19:33:13.702Z"
      }
    }
  },
  "on": {}
}
