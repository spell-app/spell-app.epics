{
  "sections": [
    {
      "id": "start",
      "title": "Start here · the app's first few",
      "icon": "star",
      "description": "The guides the Spell app shows first, for someone making things.  `yes` puts one in, `no` leaves it out;  type `yes` on another to swap it in"
