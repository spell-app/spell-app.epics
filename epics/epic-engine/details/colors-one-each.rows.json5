    {
      "id": "own-request-fixed",
      "section": "closed",
      "file": "epic/src/tool/PlanReader.ts",
      "line": 305,
      "purpose": "A quick issue Claude filed for ONE OF YOUR OWN REQUESTS, closed by Claude, never reviewed by you.  What you'd do:  look at it, then check it off.",
      "note": "Why orange:  you asked for it, so it's your turn to see it done.  It's I232's reasoning (\"make it orange so I know to go and review\").\n\nCatch:  nothing marks an issue as yours today, so a new fact is needed, written when Claude files an issue from your words.  Old issues stay grey, so the list doesn't fill with orange overnight.\n\nGoes against:  2026-10-25, about closed issues, \"make it grey after one day.  If I haven't seen it by then, I don't care.\"  To let them fade anyway, type \"orange, grey after a day\".",
      "current": "grey (since I236, this morning;  green before)",
      "recommended": "orange until reviewed"
    },
    {
      "id": "self-fixed",
      "section": "closed",
      "file": "epic/src/tool/PlanReader.ts",
      "line": 305,
      "purpose": "An issue Claude found and fixed itself, that never needed you:  a passing test failure, something it tripped over.  What you'd do:  nothing.",
      "note": "Your words, I236, 2026-11-08:  \"It should show up as grey rather than green -- I don't need to worry about transient stuff like this.\"",
      "current": "grey",
      "recommended": "grey"
    },
