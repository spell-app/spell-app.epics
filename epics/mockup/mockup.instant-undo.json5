    "before": {
      "attributes": {
        "id": "j189",
        "title": "I37:  the board's cards keep their places in the file's grid, so they never wrap into new rows as the pane narrows:  the whole block is centred, and a section narrower than the widest starts at the same left edge, not centred on its own.  Wider than its pane, the block starts 20px in from the left and scrolls (margin auto never goes below 0).  While a card moves, each section's one more column takes no room, so the centred board doesn't jump under the pointer.",
        "status": "open",
        "state": "open",
        "changed": "2026-11-16T20:51:46-05:00",
        "calm": ""
      },
      "label": null
    },
