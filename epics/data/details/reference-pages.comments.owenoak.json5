    "c3": {
      "anchor": "context#code-1",
      "kind": "code",
      "label": "1. One example: NetBox's place reference",
      "excerpt": "a \"job\" is a thing // A piece of work NetBox runs in the background, like a repo",
      "text": "deprecating the `//` on the same line, convert to `--` comments on the first line after the thing\n\n- `its status is one of ...`",
      "by": "owenoak",
      "at": "2026-11-18T14:12:26.579Z",
      "status": "answered",
      "edited": "2026-11-18T14:12:57.872Z",
      "replies": [
        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-18T14:23:59.730Z",
          "html": "<p>Converted:  the Settled example puts each description in a <code>--</code> comment on the first line after its thing.  Decision Q99;  the language-wide change is T169.</p>"
        }
      ],
      "claim": {
        "by": "owenoak",
        "agent": "claude",
        "at": "2026-11-18T14:21:13.988Z"
      }
    },
