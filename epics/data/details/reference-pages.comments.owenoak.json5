      "label": "1. One example: NetBox's place reference",
      "excerpt": "1. One example: NetBox's place reference",
      "text": "deprecating the `//` on the same line, use `--` comments on the first line in the thing",
      "by": "owenoak",
      "at": "2026-11-18T14:11:32.744Z",
      "status": "answered",
      "quote": "/ A piece of wo",
      "offset": 0,
      "edited": "2026-11-18T14:11:48.224Z",
      "replies": [
        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-18T14:23:55.055Z",
          "html": "<p>Done for reference pages:  a type's or field's words are the <code>--</code> comment on the first line inside it, which Spell already reads as its description.  Decision Q99, and P53's plan.  Deprecating same-line <code>//</code> across all of Spell is a language change, so it's a todo to send to the language epic, T169.  The example is rewritten in the Settled section.</p>"
        }
      ],
      "claim": {
        "by": "owenoak",
        "agent": "claude",
        "at": "2026-11-18T14:21:09.964Z"
      }
    },
