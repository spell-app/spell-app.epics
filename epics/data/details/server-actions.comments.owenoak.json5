    "c5": {
      "anchor": "q11",
      "kind": "section",
      "label": "Q11 · The kinds of error a step can name",
      "excerpt": "Q11 · The kinds of error a step can name",
      "text": "401 and 403 should be specific errors, e.g. \n- if \"not authorized\", you may want to let them log in.  - If \"not permitted\", you may want to let them save locally\n\nReading http status codes is for chumps.",
      "by": "owenoak",
      "at": "2026-11-18T00:52:34.753Z",
      "status": "answered",
      "quote": "not authorized",
      "offset": 454,
      "edited": "2026-11-18T00:54:32.581Z",
      "replies": [
        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-18T01:07:19.275Z",
          "html": "<p>Split:  \"not authorized\" is a 401, not signed in, so a step can let them sign in;  \"not permitted\" is a 403, signed in but not allowed, so a step can let them save on this device.  No step ever names a status code.  It is decision Q86, and round 2's Q20 table.</p>"
        }
      ],
      "claim": {
        "by": "owenoak",
        "agent": "claude",
        "at": "2026-11-18T01:03:45.900Z"
      }
    }
  },
