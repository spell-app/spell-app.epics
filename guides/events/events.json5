      "cancelable": false,
      "description": "Closed, its exit animation finished (Fomantic's `onHidden`);  the host is `hidden` now.  `UI.toast()` removes its toasts here."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-approving",
      "spanish": "aprobando",
      "sentBy": "<ui-toast>",
      "detail": "{ action: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "An approve action (`.approve` / `.ok` / `.positive`, `<ui-button positive>`) was activated;  `preventDefault()` keeps the toast open."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-denying",
      "spanish": "denegando",
      "sentBy": "<ui-toast>",
      "detail": "{ action: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "A deny action (`.deny` / `.cancel` / `.negative`, `<ui-button negative>`) was activated;  `preventDefault()` keeps the toast open."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-scrolled-to",
      "spanish": "desplazado-a",
      "sentBy": "<ui-toc>",
      "detail": "{ value: string }",
      "cancelable": false,
      "description": "The entry in view changed (scroll, a link, the tabs);  `value` is its target's id."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-drawn",
      "spanish": "dibujado",
      "sentBy": "<ui-toc>",
      "detail": "{ ids: string[] }",
      "cancelable": false,
      "description": "The list was built (again):  the ids of every entry, in page order."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-choosing",
      "spanish": "eligiendo",
      "sentBy": "<ui-toolbar>",
      "detail": "{ value: string, item: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "An interactive item (a link or button) was activated.  `value` is the item's `value`, else its text.  The menu doesn't move `selected` itself, except a `segmented` one (a single-choice control), which selects the item and unselects the rest:  `preventDefault()` keeps the old choice."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-toolbar>",
      "detail": "{ value?: string, values?: string[] }",
      "cancelable": false,
      "description": "A `segmented` menu's choice changed:  `value`, the item chosen;  a `choose=\"many\"` menu's `values`, the items now on, in order (each one's `value`, else its text)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-form-value",
      "sentBy": "<ui-toolbar>",
      "detail": "{}",
      "cancelable": false,
      "description": "A `segmented` menu with a `name` is drawn, so it holds a form value now:  a `<ui-form>` around it binds it."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-starting",
      "spanish": "empezando",
      "sentBy": "<ui-tour>",
      "detail": "{ step: number }",
      "cancelable": true,
      "description": "About to start, at `step`;  `preventDefault()` keeps it from starting."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-started",
      "spanish": "empezado",
      "sentBy": "<ui-tour>",
      "detail": "{ step: number }",
      "cancelable": false,
      "description": "Started:  its first step shows."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-stepped",
      "spanish": "de-paso",
      "sentBy": "<ui-tour>",
      "detail": "{ from: number, to: number, name: string }",
      "cancelable": false,
      "description": "Moved from step `from` to step `to` (named `name`, or `\"\"`);  `0` is no step."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-ended",
      "spanish": "terminado",
      "sentBy": "<ui-tour>",
      "detail": "{ reason: \"done\" | \"closed\" | \"stopped\" }",
      "cancelable": false,
      "description": "Ended:  `done` after its last step, `closed` by its ✕ or Escape, `stopped` by code (`stop()`, `stop tour`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opened",
      "spanish": "abierto",
      "sentBy": "<ui-transition>",
      "detail": "{ visible: true, animation: string }",
      "cancelable": false,
      "description": "Shown, its animation finished (Fomantic's `onVisible`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closed",
      "spanish": "cerrado",
      "sentBy": "<ui-transition>",
      "detail": "{ visible: false, animation: string }",
      "cancelable": false,
      "description": "Hidden, its animation finished (Fomantic's `onHidden`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-animated",
      "spanish": "animado",
      "sentBy": "<ui-transition>",
      "detail": "{ visible: boolean, animation: string }",
      "cancelable": false,
      "description": "Any animation finished, attention ones included (Fomantic's `onComplete`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-selecting",
      "spanish": "ui-seleccionando",
      "sentBy": "<ui-tree>",
      "detail": "{ item: HTMLElement | TreeItemData, value: string, path?: string[], originalEvent?: Event }",
      "cancelable": true,
      "description": "A row is about to be selected, by a click, or by Enter or Space:  cancel it to decide what's selected yourself, reading the keys held from `originalEvent`.  `appearance=\"columns\"`:  the arrow keys select as they move too;  `item` is the `<ui-tree-item>`, or the `items` entry;  `path`, the ids of each column's pick down to it."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-tree>",
      "detail": "{ value: string, values: string[], item?: HTMLElement | TreeItemData, path?: string[], originalEvent?: Event }",
      "cancelable": false,
      "description": "What's selected changed:  `value`, the row clicked;  `values`, every selected row in the tree's order (each one's `value`, else its `label`).  `appearance=\"columns\"`:  also `item` and `path`, as `ui-selecting`'s."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-settled",
      "spanish": "ui-asentado",
      "sentBy": "<ui-tree>",
      "detail": "{ value: string, values: string[], item?: HTMLElement | TreeItemData, path?: string[], originalEvent?: Event }",
      "cancelable": false,
      "description": "What's selected has stayed put for a moment:  `ui-changed`'s detail, once the arrow keys stop.  For a page doing heavy work on each pick."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-node-clicked",
      "spanish": "nodo-pulsado",
      "sentBy": "<ui-tree-diagram>",
      "detail": "{ node: { label: string, element?: Element }, path: string, originalEvent: Event }",
      "cancelable": false,
      "description": "A node was clicked, with or without `clickable`.  `path` is its place, its child index at each depth:  `0.2.1`.  A nested tag's node has its `element`."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-node-toggled",
      "spanish": "nodo-plegado",
      "sentBy": "<ui-tree-diagram>",
      "detail": "{ node: { label: string, element?: Element }, path: string, folded: boolean, originalEvent: Event }",
      "cancelable": false,
      "description": "A person folded a node, or opened it again."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-tree-item>",
      "detail": "{ open: boolean, originalEvent?: Event }",
      "cancelable": true,
      "description": "It's about to open:  cancel it to stay closed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-tree-item>",
      "detail": "{ open: boolean, originalEvent?: Event }",
      "cancelable": true,
      "description": "It's about to close:  cancel it to stay open."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-file-dragged-over",
      "spanish": "archivo-arrastrado-sobre",
      "sentBy": "<ui-uploader>",
      "detail": "{ count: number, kinds: string[], via: \"drop\" | \"zone\" }",
      "cancelable": false,
      "description": "Files are dragged over it, or over its `drop-zone`:  how many, and their kinds.",
      "line": "when a file is dragged over it:",
      "lineEs": "cuando un archivo se arrastra sobre ella:",
      "handler": "whenFileDraggedOver"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-file-dragged-out",
      "spanish": "archivo-arrastrado-fuera",
      "sentBy": "<ui-uploader>",
      "detail": "{ count: number, kinds: string[], via: \"drop\" | \"zone\" }",
      "cancelable": false,
      "description": "The files dragged over it left without being dropped.",
      "line": "when a file is dragged out of it:",
      "lineEs": "cuando un archivo se arrastra fuera de ella:",
      "handler": "whenFileDraggedOutOf"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-folder-dragged-over",
      "spanish": "carpeta-arrastrada-sobre",
      "sentBy": "<ui-uploader>",
      "detail": "{ count: number, kinds: string[], via: \"drop\" | \"zone\" }",
      "cancelable": false,
      "description": "With `folder`:  `ui-file-dragged-over`'s twin.  While dragging, a browser can't tell a folder from a file."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-folder-dragged-out",
      "spanish": "carpeta-arrastrada-fuera",
      "sentBy": "<ui-uploader>",
      "detail": "{ count: number, kinds: string[], via: \"drop\" | \"zone\" }",
      "cancelable": false,
      "description": "With `folder`:  `ui-file-dragged-out`'s twin."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-file-dropping",
      "spanish": "archivo-soltandose",
      "sentBy": "<ui-uploader>",
      "detail": "{ file: File, name: string, path: string, size: number, type: string, lastModified: number, via: \"dialog\" | \"drop\" | \"zone\", reason?: string, entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": true,
      "description": "A file picked or dropped is about to be taken:  cancel it to leave it out.  `reason` says why it'll be turned away, when it will be."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-file-dropped",
      "spanish": "archivo-soltado",
      "sentBy": "<ui-uploader>",
      "detail": "{ file: File, name: string, path: string, size: number, type: string, lastModified: number, via: \"dialog\" | \"drop\" | \"zone\", reason?: string, entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": false,
      "description": "A file was taken, kept or turned away (`reason`), the same for a pick (`via: \"dialog\"`) as for a drop.  `file.text()` reads it.  `entry` and `handle` are there when the browser gives them:  an entry on any drop, a handle on a drop in Chrome and Edge.",
      "line": "when a file is dropped on it:",
      "lineEs": "cuando un archivo se suelta sobre ella:",
      "handler": "whenFileDroppedOn"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-folder-dropping",
      "spanish": "carpeta-soltandose",
      "sentBy": "<ui-uploader>",
      "detail": "{ name: string, path: string, files: File[], via: \"dialog\" | \"drop\" | \"zone\", reason?: string, entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": true,
      "description": "With `folder`:  a folder is about to be taken, with its files:  cancel it to leave it all out."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-folder-dropped",
      "spanish": "carpeta-soltada",
      "sentBy": "<ui-uploader>",
      "detail": "{ name: string, path: string, files: File[], via: \"dialog\" | \"drop\" | \"zone\", reason?: string, entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": false,
      "description": "With `folder`:  a folder was taken;  a `ui-file-dropped` follows for each file in it.",
      "line": "when a folder is dropped on it:",
      "lineEs": "cuando una carpeta se suelta sobre ella:",
      "handler": "whenFolderDroppedOn"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-uploading",
      "spanish": "subiendo",
      "sentBy": "<ui-uploader>",
      "detail": "{ files: File[] }",
      "cancelable": true,
      "description": "The files kept are about to be posted to `destination`, or handed to `action`:  cancel it to take the upload over, and nothing is posted or called.",
      "line": "when uploading:",
      "lineEs": "al subir:",
      "handler": "onUploading"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-upload-progress",
      "spanish": "progreso-subida",
      "sentBy": "<ui-uploader>",
      "detail": "{ file: File, sent: number, size: number }",
      "cancelable": false,
      "description": "While a file posts:  how many bytes have gone, of its size."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-uploaded",
      "spanish": "subido",
      "sentBy": "<ui-uploader>",
      "detail": "{ file: File, response: unknown }",
      "cancelable": false,
      "description": "A file was posted:  `response` is the server's answer, as JSON when it says so, else text;  with `action`, what the action returned.",
      "line": "when a file is uploaded:",
      "lineEs": "cuando un archivo se sube:",
      "handler": "whenFileUploaded"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-upload-failed",
      "spanish": "fallo-al-subir",
      "sentBy": "<ui-uploader>",
      "detail": "{ file: File, error: Error }",
      "cancelable": false,
      "description": "A file couldn't be posted, or the `action` threw:  `error` says why.",
      "line": "when a file fails to upload:",
      "lineEs": "cuando un archivo no se puede subir:",
      "handler": "whenFileFailsToUpload"
    },
    {
      "group": "Spell UI's components",
      "event": "ui-play",
      "spanish": "reproduce",
      "sentBy": "<ui-video>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It started playing (or went on)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-pause",
      "spanish": "pausa",
      "sentBy": "<ui-video>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It paused."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-ended",
      "spanish": "termina",
      "sentBy": "<ui-video>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It played to the end."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-in-view",
      "spanish": "en-vista",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "Some of it came on screen (`onOnScreen`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-out-of-view",
      "spanish": "fuera-de-vista",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "None of it is on screen (`onOffScreen`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-top-in-view",
      "spanish": "arriba-en-vista",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "Its top came on screen."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-bottom-in-view",
      "spanish": "abajo-en-vista",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "Its bottom came on screen."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-top-passed",
      "spanish": "arriba-pasado",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "Its top passed the screen top."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-bottom-passed",
      "spanish": "abajo-pasado",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "Its bottom passed the screen top."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-passing",
      "spanish": "pasando",
      "sentBy": "<ui-visibility>",
      "detail": "VisibilityCalculations",
      "cancelable": false,
      "description": "It spans the screen top."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-loaded",
      "spanish": "cargado",
      "sentBy": "<ui-visibility>",
      "detail": "{ image: HTMLImageElement }",
      "cancelable": false,
      "description": "`type=\"image\"`:  an image got its source (and finished its transition)."
    },
    {
      "group": "A view's element",
      "event": "ui-dragged-over",
      "spanish": "arrastrado-sobre",
      "sentBy": "a view's element",
      "detail": "{ thing: object, list: object, x: number, y: number }",
      "cancelable": false,
      "description": "A thing is dragged over this list:  as it comes over, then while it moves, at most every 100ms.  `thing` and `list` are the program's things, `x` and `y` where the pointer is.",
      "line": "when a card is dragged over it:",
      "lineEs": "cuando una carta se arrastra sobre ella:",
      "handler": "whenCardDraggedOver",
      "handlerEs": "whenCartaDraggedOver"
    },
    {
      "group": "A view's element",
      "event": "ui-dragged-out",
      "spanish": "arrastrado-fuera",
      "sentBy": "a view's element",
      "detail": "{ thing: object, list: object }",
      "cancelable": false,
      "description": "The thing left this list, or was dropped on it and not taken.",
      "line": "when a card is dragged out of it:",
      "lineEs": "cuando una carta se arrastra fuera de ella:",
      "handler": "whenCardDraggedOutOf",
      "handlerEs": "whenCartaDraggedOutOf"
    },
    {
      "group": "A view's element",
      "event": "ui-dropped",
      "spanish": "soltado",
      "sentBy": "a view's element",
      "detail": "{ thing: object, list: object }",
      "cancelable": false,
      "description": "The thing was dropped on this list, and the list took it.",
      "line": "when a card is dropped on it:",
      "lineEs": "cuando una carta se suelta sobre ella:",
      "handler": "whenCardDroppedOn",
      "handlerEs": "whenCartaDroppedOn"
    },
    {
      "group": "A view's element",
      "event": "ui-file-dragged-over",
      "spanish": "archivo-arrastrado-sobre",
      "sentBy": "a view's element",
      "detail": "{ count: number, kinds: string[], via: \"drop\", x: number, y: number }",
      "cancelable": false,
      "description": "Files from the desktop are dragged over a view with a file line (`when a file is dropped on it:`):  how many, and their kinds;  again while they move, at most every 100ms.",
      "line": "when a file is dragged over it:",
      "lineEs": "cuando un archivo se arrastra sobre ella:",
      "handler": "whenFileDraggedOver"
    },
    {
      "group": "A view's element",
      "event": "ui-file-dragged-out",
      "spanish": "archivo-arrastrado-fuera",
      "sentBy": "a view's element",
      "detail": "{ count: number, kinds: string[], via: \"drop\" }",
      "cancelable": false,
      "description": "The files left without being dropped.",
      "line": "when a file is dragged out of it:",
      "lineEs": "cuando un archivo se arrastra fuera de ella:",
      "handler": "whenFileDraggedOutOf"
    },
    {
      "group": "A view's element",
      "event": "ui-file-dropped",
      "spanish": "archivo-soltado",
      "sentBy": "a view's element",
      "detail": "{ file: File, name: string, path: string, size: number, type: string, lastModified: number, via: \"drop\", entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": false,
      "description": "A file was dropped on the view:  the same detail as `<ui-uploader>`'s, one event per file.",
      "line": "when a file is dropped on it:",
      "lineEs": "cuando un archivo se suelta sobre ella:",
      "handler": "whenFileDroppedOn"
    },
    {
      "group": "A view's element",
      "event": "ui-folder-dropped",
      "spanish": "carpeta-soltada",
      "sentBy": "a view's element",
      "detail": "{ name: string, path: string, files: File[], via: \"drop\", entry?: FileSystemEntry, handle?: FileSystemHandle }",
      "cancelable": false,
      "description": "A folder was dropped on the view:  a `ui-file-dropped` follows for each file in it.",
      "line": "when a folder is dropped on it:",
      "lineEs": "cuando una carpeta se suelta sobre ella:",
      "handler": "whenFolderDroppedOn"
    },
    {
      "group": "The program's own",
      "cancelable": false,
      "event": "{thing}-drop",
      "spanish": "soltar-{thing}",
      "sentBy": "the program, as a thing is dropped on a list with no `dropped on it` line",
      "detail": "{ card, pile }:  the thing by its type, the list by each of its types",
      "description": "A program hears it with `on card drop`;  nobody listening, the thing moves there, by the lists' rules.",
      "line": "on card drop with a card and a pile:",
      "lineEs": "al soltar-carta con una carta y una pila:",
      "handler": "onCardDrop",
      "handlerEs": "onSoltarCarta"
    },
    {
      "group": "The program's own",
      "cancelable": false,
      "event": "{name}-sound-ends",
      "sentBy": "the program, as a named sound or video plays",
      "description": "A named sound or video ended:  also `-starts` and `-pauses`, and `-video-` for a video.  The same name in every language.",
      "line": "when the \"card slide\" sound ends:",
      "lineEs": "cuando el sonido \"card slide\" termina:",
      "handler": "onCardSlideSoundEnds"
    }
  ]
}
