{
  "about": "Every event a page can listen for, and the Spell line that hears it:  GENERATED by `spell events write` (the app folder's EventsPage), never edited by hand.  Drawn by events.html beside it.",
  "rows": [
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-accordion>",
      "detail": "{ index: number, open: true, title: Element, content?: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "A panel is about to open;  `preventDefault()` keeps it closed.  NOT cancelable in effect when the browser opened it itself (find-in-page)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-accordion>",
      "detail": "{ index: number, open: false, title: Element, content?: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "A panel is about to close -- its title was activated, or another panel is opening in an `exclusive` accordion;  `preventDefault()` keeps it open (and then the other one closed)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-loading",
      "spanish": "cargando",
      "sentBy": "<ui-accordion>",
      "detail": "{ source: string }",
      "cancelable": false,
      "description": "The `source` file is on its way:  the section unfolded for the first time, or `reloadBody()`."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-loaded",
      "spanish": "cargado",
      "sentBy": "<ui-accordion>",
      "detail": "{ source: string, content: string }",
      "cancelable": false,
      "description": "The `source` file arrived and its body is in place (`content` is the file's text)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-error",
      "spanish": "error",
      "sentBy": "<ui-accordion>",
      "detail": "{ kind: 'load' | 'cross-origin' | 'file-protocol' | 'render', source: string, error: unknown }",
      "cancelable": true,
      "description": "The `source` file couldn't be loaded or shown;  `kind` says why.  An error line shows in the content unless cancelled;  opening it again tries again."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-choosing",
      "spanish": "eligiendo",
      "sentBy": "<ui-app-menu>",
      "detail": "{ value: string, item: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "An interactive item (a link or button) was activated.  `value` is the item's `value`, else its text.  The menu doesn't move `selected` itself, except a `segmented` one (a single-choice control), which selects the item and unselects the rest:  `preventDefault()` keeps the old choice."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-app-menu>",
      "detail": "{ value?: string, values?: string[] }",
      "cancelable": false,
      "description": "A `segmented` menu's choice changed:  `value`, the item chosen;  a `choose=\"many\"` menu's `values`, the items now on, in order (each one's `value`, else its text)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-form-value",
      "sentBy": "<ui-app-menu>",
      "detail": "{}",
      "cancelable": false,
      "description": "A `segmented` menu with a `name` is drawn, so it holds a form value now:  a `<ui-form>` around it binds it."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-play",
      "spanish": "reproduce",
      "sentBy": "<ui-audio>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It started playing (or went on)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-pause",
      "spanish": "pausa",
      "sentBy": "<ui-audio>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It paused."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-ended",
      "spanish": "termina",
      "sentBy": "<ui-audio>",
      "detail": "{ currentTime: number }",
      "cancelable": false,
      "description": "It played to the end."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-selected",
      "spanish": "seleccionado",
      "sentBy": "<ui-button>",
      "detail": "{ active: true, originalEvent?: Event }",
      "cancelable": false,
      "description": "A `toggle` button turned `selected` on.  NOTE: plain clicks are the native `click`."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-deselected",
      "spanish": "deseleccionado",
      "sentBy": "<ui-button>",
      "detail": "{ active: false, originalEvent?: Event }",
      "cancelable": false,
      "description": "A `toggle` button turned `selected` off."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changing",
      "spanish": "cambiando",
      "sentBy": "<ui-calendar>",
      "detail": "{ value: string, originalEvent?: Event }",
      "cancelable": true,
      "description": "The person chose, typed or cleared a value;  `preventDefault()` keeps the old one."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-calendar>",
      "detail": "{ value: string, originalEvent?: Event }",
      "cancelable": false,
      "description": "The value changed:  after `ui-changing`, unless it was cancelled."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-calendar>",
      "detail": "{ open: true, originalEvent?: Event }",
      "cancelable": true,
      "description": "The popup is about to open;  `preventDefault()` keeps it closed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-calendar>",
      "detail": "{ open: false, originalEvent?: Event }",
      "cancelable": true,
      "description": "The popup is about to close;  `preventDefault()` keeps it open."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-checkbox>",
      "detail": "{ selected: boolean, value: string, originalEvent?: Event }",
      "cancelable": false,
      "description": "Someone chose or unchose it (a radio:  only the newly chosen one fires);  `value`:  what it stands for after the change, a checkbox's `off-value` once unchosen."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-loaded",
      "spanish": "cargado",
      "sentBy": "<ui-code>",
      "detail": "{ source?: string, content: string }",
      "cancelable": false,
      "description": "Content arrived:  fetched from `source`, or read from the element's own content."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-code>",
      "detail": "{ content: string }",
      "cancelable": false,
      "description": "The `content` property was set:  the element shows the new text, and is `dirty` until saved."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-saving",
      "spanish": "guardando",
      "sentBy": "<ui-code>",
      "detail": "{ source?: string, content: string, etag?: string }",
      "cancelable": true,
      "description": "`host.save()` is about to save:  `preventDefault()` to save it yourself (an editor posting elsewhere)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-saved",
      "spanish": "guardado",
      "sentBy": "<ui-code>",
      "detail": "{ source?: string, etag?: string }",
      "cancelable": false,
      "description": "Saved;  `etag` is the file's new version."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-error",
      "spanish": "error",
      "sentBy": "<ui-code>",
      "detail": "{ kind: 'load' | 'cross-origin' | 'file-protocol' | 'save' | 'conflict' | 'no-saver' | 'render', source?: string, error: unknown }",
      "cancelable": true,
      "description": "Loading, showing or saving failed;  `kind` says why.  Load and render failures show an error message unless cancelled;  save failures keep the content as it is."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-coloured",
      "spanish": "resaltado",
      "sentBy": "<ui-code>",
      "detail": "{ language?: string, detected: boolean }",
      "cancelable": false,
      "description": "Coloured:  `language` is what it was coloured as (`undefined`:  plain text), `detected` when it was guessed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-copied",
      "spanish": "copiado",
      "sentBy": "<ui-code>",
      "detail": "{ content: string }",
      "cancelable": false,
      "description": "The copy button copied `content`."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-device>",
      "detail": "{ device: \"phone\" | \"tablet\" | \"desktop\", orientation: \"portrait\" | \"landscape\", originalEvent?: Event }",
      "cancelable": false,
      "description": "A person changed the device or turned it, with its own buttons;  `device` and `orientation` say what it is now."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opened",
      "spanish": "abierto",
      "sentBy": "<ui-device>",
      "detail": "{ visible: true }",
      "cancelable": false,
      "description": "With `modal`:  shown, its entry transition finished."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closed",
      "spanish": "cerrado",
      "sentBy": "<ui-device>",
      "detail": "{ visible: false }",
      "cancelable": false,
      "description": "With `modal`:  hidden, its exit transition finished."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-node-clicked",
      "spanish": "nodo-pulsado",
      "sentBy": "<ui-diagram>",
      "detail": "{ name: string, originalEvent: Event }",
      "cancelable": false,
      "description": "A box was clicked (not dragged):  `name` is the box's name."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-node-moved",
      "spanish": "nodo-movido",
      "sentBy": "<ui-diagram>",
      "detail": "{ name: string, dx: number, dy: number }",
      "cancelable": false,
      "description": "A box was dragged and let go:  `dx`, `dy` is how far it now is from where the layout put it, in user units."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-moved",
      "spanish": "movido",
      "sentBy": "<ui-dial>",
      "detail": "{ value: number, originalEvent?: Event }",
      "cancelable": false,
      "description": "The handle moved (each drag step, key or wheel turn).  A handler that re-sets `value` wins."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-dial>",
      "detail": "{ value: number, originalEvent?: Event }",
      "cancelable": false,
      "description": "A change was committed:  on a key or wheel turn, or when a drag ends somewhere new."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-dimmer>",
      "detail": "{ visible: true, originalEvent?: Event }",
      "cancelable": true,
      "description": "About to show for a person's action (`show-on`, an invoker command);  `preventDefault()` keeps it hidden."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opened",
      "spanish": "abierto",
      "sentBy": "<ui-dimmer>",
      "detail": "{ visible: true }",
      "cancelable": false,
      "description": "Shown, its transition finished (Fomantic's `onVisible`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-dimmer>",
      "detail": "{ visible: false, reason: DimmerCloseReason, originalEvent?: Event }",
      "cancelable": true,
      "description": "About to hide:  a click on it, Escape, the pointer leaving.  `preventDefault()` keeps it shown."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closed",
      "spanish": "cerrado",
      "sentBy": "<ui-dimmer>",
      "detail": "{ visible: false }",
      "cancelable": false,
      "description": "Hidden, its transition finished (Fomantic's `onHidden`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-changed",
      "spanish": "cambiado",
      "sentBy": "<ui-dropdown>",
      "detail": "{ value: string | string[], originalEvent?: Event }",
      "cancelable": false,
      "description": "Someone chose, added, removed or cleared a value."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-dropdown>",
      "detail": "{ open: true, originalEvent?: Event }",
      "cancelable": true,
      "description": "The menu is about to open (a person's action, an invoker command too);  `preventDefault()` keeps it closed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-dropdown>",
      "detail": "{ open: false, originalEvent?: Event }",
      "cancelable": true,
      "description": "The menu is about to close;  `preventDefault()` keeps it open."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-searched",
      "spanish": "buscado",
      "sentBy": "<ui-dropdown>",
      "detail": "{ query: string, originalEvent?: Event }",
      "cancelable": false,
      "description": "`search`:  the query changed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-added",
      "spanish": "agregado",
      "sentBy": "<ui-dropdown>",
      "detail": "{ value: string, originalEvent?: Event }",
      "cancelable": false,
      "description": "`multiple`:  a value was chosen, or `allow-additions` added a new one."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-removed",
      "spanish": "quitado",
      "sentBy": "<ui-dropdown>",
      "detail": "{ value: string, originalEvent?: Event }",
      "cancelable": false,
      "description": "`multiple`:  a value was removed."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-loading",
      "spanish": "cargando",
      "sentBy": "<ui-embed>",
      "detail": "{ url: string, originalEvent?: Event }",
      "cancelable": true,
      "description": "About to load the frame from `url` (a click, Enter / Space, `host.activate()`);  `preventDefault()` keeps the placeholder."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-reset",
      "spanish": "restablecer",
      "sentBy": "<ui-embed>",
      "detail": "{}",
      "cancelable": false,
      "description": "Back to the placeholder (`host.reset()`, Fomantic's `reset`):  the frame is gone."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opened",
      "spanish": "abierto",
      "sentBy": "<ui-example>",
      "detail": "{ open: true, originalEvent?: Event }",
      "cancelable": false,
      "description": "The code button opened the code pane."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closed",
      "spanish": "cerrado",
      "sentBy": "<ui-example>",
      "detail": "{ open: false, originalEvent?: Event }",
      "cancelable": false,
      "description": "The code button closed the code pane."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opening",
      "spanish": "abriendo",
      "sentBy": "<ui-flyout>",
      "detail": "{ visible: true, originalEvent?: Event }",
      "cancelable": true,
      "description": "About to show (a person's action, not a `visible` write);  `preventDefault()` keeps it hidden."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-opened",
      "spanish": "abierto",
      "sentBy": "<ui-flyout>",
      "detail": "{ visible: true }",
      "cancelable": false,
      "description": "Shown, its entry transition finished (Fomantic's `onVisible`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closing",
      "spanish": "cerrando",
      "sentBy": "<ui-flyout>",
      "detail": "{ visible: false, reason: ModalCloseReason, originalEvent?: Event }",
      "cancelable": true,
      "description": "About to hide:  Escape, the dimmer, the close icon, approve or deny.  `preventDefault()` keeps it shown."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-closed",
      "spanish": "cerrado",
      "sentBy": "<ui-flyout>",
      "detail": "{ visible: false }",
      "cancelable": false,
      "description": "Hidden, its exit transition finished (Fomantic's `onHidden`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-approving",
      "spanish": "aprobando",
      "sentBy": "<ui-flyout>",
      "detail": "{ action: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "An approve button (`.approve` / `.ok` / `.positive`, `<ui-button positive>`) was activated;  `preventDefault()` keeps it shown (Fomantic's `onApprove` returning `false`)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-denying",
      "spanish": "denegando",
      "sentBy": "<ui-flyout>",
      "detail": "{ action: Element, originalEvent?: Event }",
      "cancelable": true,
      "description": "A deny button (`.deny` / `.cancel` / `.negative`, `<ui-button negative>`) was activated;  `preventDefault()` keeps it shown."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-valid",
      "spanish": "valido",
      "sentBy": "<ui-form>",
      "detail": "{ field: string, value: FieldValue, values: Record<string, FieldValue> }",
      "cancelable": false,
      "description": "A field passed validation."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-invalid",
      "spanish": "invalido",
      "sentBy": "<ui-form>",
      "detail": "{ field: string, value: FieldValue, errors: string[], values: Record<string, FieldValue> }",
