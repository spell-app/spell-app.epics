      "cancelable": false,
      "description": "A submit failed validation (the native submission is stopped);  `errors` by field."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-applying",
      "spanish": "aplicando",
      "sentBy": "<ui-form>",
      "detail": "{ changes: FormChange[], value: unknown }",
      "cancelable": true,
      "description": "`save()`, with `apply=\"on save\"`:  the held edits are about to land;  `preventDefault()` keeps them held."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-applied",
      "spanish": "aplicado",
      "sentBy": "<ui-form>",
      "detail": "{ changes: FormChange[], value: unknown }",
      "cancelable": false,
      "description": "The held edits landed in the bound `value`."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-cancelling",
      "spanish": "cancelando",
      "sentBy": "<ui-form>",
