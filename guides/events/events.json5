    },
    {
      "group": "Spell UI's components",
      "event": "ui-saving",
      "spanish": "guardando",
      "sentBy": "<ui-form>",
      "detail": "{ values: Record<string, FieldValue>, originalEvent?: Event }",
      "cancelable": true,
      "description": "A submit passed validation;  `preventDefault()` stops the native submission (e.g. to send it by fetch)."
    },
    {
      "group": "Spell UI's components",
      "event": "ui-save-failed",
      "spanish": "fallo-al-guardar",
