    "c25": {
      "anchor": "rs-signup#markdown-2",
      "kind": "markdown",
      "label": "7.1 A sign-up sheet",
      "excerpt": "Organizer notes stay private: \"get someone more reliable on this shift as well\"",
      "text": "table",
      "by": "owenoak",
      "at": "2026-11-02T03:35:48.871Z",
      "status": "answered",
      "quote": "Organizer notes stay private: \"get someone more reliable on this shift as well\" is never in the projection.\nA sheet can be drafted: nothing is public until it's published.\nTwo people can't both take the last place on a shift: every sign-up goes through Spell, which checks the one master sheet and refuses the second.",
      "offset": 0,
      "replies": [
        {
          "by": "owenoak",
          "agent": "claude",
          "at": "2026-11-02T03:38:41.623Z",
          "html": "<p>Done:  a table.  I reworded the last-place row so it matches your ticket comment:  the write server refuses a sign-up made from an out-of-date copy, and doesn't need to know about shifts.</p>"
        }
      ],
      "claim": {
        "by": "owenoak",
        "agent": "claude",
        "at": "2026-11-02T03:38:26.917Z"
      }
    },
