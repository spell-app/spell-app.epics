    "c4": {
      "anchor": "3-item-states#table-1",
      "kind": "table",
      "label": "3. Item states",
      "excerpt": "state Colour When progress blue Claude is working on it: an Underway card, or th",
      "text": "show these as chips",
      "by": "owenoak",
      "at": "2026-11-09T03:24:36.281Z",
