// The content repo's part of the kit's page server settings (epic `repo-split` P16):  what describes THIS repo's pages,
// read by the kit's `pageServerSettings()` from the content folder (`CONTENT_SETTINGS`), merged after the kit's own
// part and before each child repo's.
// - `writable`:  the folders here the page editor and `/api/files` may write
// - `gone`:  URL prefixes answered "not found" though this repo still holds them (`ui/`, Spell UI's old docs, kept for
//   older checkouts;  now `/components/ui/`)
// - `siteTabs`:  the site header's tabs, in its order;  a tab whose home is a component set none of whose sets is
//   served (App/UI without spell-app) is left out
// - spell-app's `package.json` held all three until P16.
{
  "writable": [
    "epics",
    "guides",
    "pages",
    "brand"
  ],
  "gone": [
    "/ui"
  ],
  "siteTabs": [
    {
      "name": "Guides",
      "path": "guides/index.html",
      "areas": [
        "guides"
      ]
    },
    {
      "name": "Sagas",
      "path": "sagas/index.html",
      "areas": [
        "sagas",
        "goals"
      ]
    },
    {
      "name": "Epics",
      "path": "epics/index.html",
      "areas": [
        "epics"
      ]
    },
    {
      "name": "Epic/UI",
      "path": "/components/epics/",
      "serverOnly": true,
      "sets": [
        "epics"
      ],
      "paths": [
        "/spell-epic/src/docs/"
      ]
    },
    {
      "name": "Spell/UI",
      "path": "/components/ui/",
      "serverOnly": true,
      "sets": [
        "ui"
      ],
      "paths": [
        "/spell-ui/docs/",
        "/spell-ui/site/"
      ]
    },
    {
      "name": "App",
      "path": "/editor/",
      "serverOnly": true,
      "ownTab": true,
      "paths": [
        "^/editor(/|$)"
      ]
    },
    {
      "name": "App/UI",
      "path": "/components/app/",
      "serverOnly": true,
      "sets": [
        "app"
      ],
      "paths": [
        "/spell-app/app/docs/"
      ]
    },
    {
      "name": "Brand",
      "path": "brand/index.html",
      "areas": [
        "brand"
      ],
      "sets": [
        "brand"
      ],
      "paths": [
        "/spell-brand/docs/"
      ]
    }
  ]
}
