{
  // `packages/docs/content/` here holds only the OLD-path links (into `epics/`, `guides/` ...), for checkouts on
  // code from before 2026-10-05 (claude-design T1):  hidden, so Explorer and Quick Open show each page once.
  "files.exclude": {
    "packages": true
  },
  // Hand-edited CSS (a details page's own stylesheet, like the language epic's `bubbly.css`) formats on save,
  // with oxfmt, through the Oxc extension:  the kit's settings, copied into this repo's `.oxfmtrc.json`.
  // - Pinned per language:  the user settings name Prettier, which isn't installed, so nothing formatted.
  // - NOT html:  the epic tools write the pages.
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.formatOnSave": true }
}
